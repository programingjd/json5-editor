{
  "name": "gpui-json5-editor-web",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "node ../scripts/build-wasm.mjs",
    "build:wasm:debug": "node ../scripts/build-wasm.mjs --debug",
    "dev": "npm run build:wasm && vite",
    "dev:debug": "npm run build:wasm:debug && vite",
    "build": "npm run build:wasm && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "node --test ../editor/src/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7",
    "@resvg/resvg-js": "^2.6",
    "smol-toml": "^1.9",
    "vite": "^8",
    "vite-plugin-static-copy": "^4.1",
    "vite-plugin-wasm": "^3.6",
    "web-ext": "^10.8"
  },
  "packageManager": "npm@12.2.1"
}
