          "color": "#000080"
        },
        "constant": {
          "color": "#000080"
        },
        "number": {
          "color": "#0000ff"
        },
        "property": {
          "color": "#660e7a"
        },
        "punctuation": {
          "color": "#000000"
        },
        "punctuation.bracket": {
          "color": "#000000"
        },
        "punctuation.delimiter": {
          "color": "#000000"
        },
        "operator": {
          "color": "#000000"
        }
      }
    }
